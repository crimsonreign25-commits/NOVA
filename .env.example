# Copy this file to ".env" and fill in your key. Never commit the real .env.

# --- Free AI provider (Groq, no credit card needed) ---
# 1. Go to https://console.groq.com
# 2. Sign up / log in
# 3. Go to "API Keys" -> "Create API Key"
# 4. Paste it below
OPENAI_API_KEY=your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
NOVA_MODEL=llama-3.3-70b-versatile

# --- Optional: local Ollama instead of / alongside Groq ---
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Which provider to prefer when both are configured: auto | openai | ollama
NOVA_PROVIDER=auto

# --- Server ---
PORT=8787
# Restrict CORS to your deployed frontend once you have one, e.g. https://your-app.onrender.com
NOVA_ALLOWED_ORIGIN=*
